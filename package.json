    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-webpack-plugin": "^4.2.0",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "bufferutil": "^4.1.0",
    "commander": "^15.0.0",
    "patch-package": "^8.0.1",
    "puppeteer-core": "24.14.0",
    "utf-8-validate": "^6.0.6"
  },
  "overrides": {
    "brace-expansion": "^5.0.7"
  },
  "allowScripts": {
