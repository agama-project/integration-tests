{
  "name": "agama-integration-tests",
  "version": "0.0.1",
  "description": "Agama integration tests",
  "private": true,
  "license": "GPLv2",
  "scripts": {
    "build": "webpack --mode production",
    "devel": "webpack --mode development",
    "watch": "webpack --mode development --watch",
