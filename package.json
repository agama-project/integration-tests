    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.12.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
